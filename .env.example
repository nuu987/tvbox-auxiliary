# cp .env.example .env first before use.

# Master auth password
# Please replace it to your own secret.
#
ADMIN_TOKEN=tvboxauxiliarydevadministration

# Listening port
#
# Default: 25678
#
PORT=25678

# Data folder for TA
#
# Default: ./data
#
DATA_DIR=./data

# You can add up to 6 api sources, 0 for unlimited.
#
# Default: 6
#
MAX_DATA_SOURCES=6

# Tvbox api address, all proxied resources would share 
# the same address and port, like eg. http://192.168.1.100:5678
# You don't need this if you running in Docker,
# enable auto config in the panel and leave it blank to disable.
#
# Default: disabled
#
# BASE_URL=

# Cron schedule for auto update, disabled by default.
# accpet in 5 fields format, when set, the auto update in
# the panel would be disabled.
#
# Default: disabled
#
# CRON_SCHEDULE=

# Set to true/1/yes/on for verbose logging.
#
# Default: disabled
#
# VERBOSE=

# Time setting.
#
# Default: Asia/Shanghai
#
TZ=Asia/Shanghai

# Obsoleted name in future release
# MacCMS API timeout value, in milliseconds
#
# Default: 3000
#
SITE_TIMEOUT_MS=3000

# Timeout value for fetching Tvbox sources
#
# Default: 15000 (15s)
#
FETCH_TIMEOUT_MS=15000



# Dev only, DO NOT USE OR CHANGE
#REFRESH_TOKEN=
#SCRAPE_SOURCE_URL=
#SCRAPE_SOURCE_REFERER=
#MACCMS_API_URL=
#MACCMS_AES_KEY=
#MACCMS_AES_IV=
